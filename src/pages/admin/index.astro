---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { adminAuth } from '../../lib/auth';
import { dashboard, periodOf } from '../../lib/stats';

// Admin, onglet « Statistiques » (page d'accueil de l'admin) : données de src/lib/stats.ts
export const prerender = false;

const auth = await adminAuth(Astro);
if (auth.response) return auth.response;

const presets = [7, 30, 90];
const requested = Number(Astro.url.searchParams.get('jours'));
const days = presets.includes(requested) ? requested : 30;
const period = periodOf(days);
const stats = auth.loggedIn ? await dashboard(period) : null;

const number = new Intl.NumberFormat('fr-FR');
const percent = new Intl.NumberFormat('fr-FR', { style: 'percent', maximumFractionDigits: 1 });

// Évolution par rapport à la période précédente
function delta(current: number, previous: number) {
	if (previous === 0) return current > 0 ? { text: 'nouveau', up: true } : null;
	const change = (current - previous) / previous;
	if (Math.abs(change) < 0.005) return { text: '= stable', up: null };
	return { text: `${change > 0 ? '▲ +' : '▼ '}${percent.format(change).replace('-', '−')}`, up: change > 0 };
}

const kpis = stats
	? [
			{ label: 'Visites', value: stats.current.views, previous: stats.previous.views },
			{ label: 'Visiteurs', value: stats.current.visitors, previous: stats.previous.visitors },
			{ label: 'Clics vers Patreon', value: stats.current.packClicks, previous: stats.previous.packClicks },
			{ label: 'Lectures de la vidéo', value: stats.current.videos, previous: stats.previous.videos },
		]
	: [];
const conversion = stats && stats.current.visitors > 0 ? stats.current.packClicks / stats.current.visitors : null;
const previousConversion = stats && stats.previous.visitors > 0 ? stats.previous.packClicks / stats.previous.visitors : null;

// Visites par jour, jours sans visite compris
const dayList: string[] = [];
for (let i = days - 1; i >= 0; i--) dayList.push(periodOf(i + 1).from);
const byDay = new Map(stats?.daily.map((row) => [row.day, row]) ?? []);
const series = dayList.map((day) => ({ day, views: byDay.get(day)?.views ?? 0, visitors: byDay.get(day)?.visitors ?? 0 }));
const peak = series.reduce((a, b) => (b.views > a.views ? b : a), series[0]);

// Graduation : 0, la moitié et un maximum rond
function niceMax(value: number) {
	if (value <= 4) return 4;
	const power = 10 ** Math.floor(Math.log10(value));
	const step = [1, 2, 2.5, 5, 10].map((n) => n * power).find((n) => n >= value / 2)!;
	return step * 2;
}
const yMax = niceMax(peak?.views ?? 0);

const dateLong = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'UTC' });
const dateShort = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const asDate = (day: string) => new Date(`${day}T12:00:00Z`);
// Dates sous l'axe : 6 repères au plus, répartis régulièrement
const tickEvery = Math.max(1, Math.ceil(days / 6));

const clickLabels: Record<string, string> = {
	basique: 'Pack Basique',
	plus: 'Pack Plus',
	patreon: 'Voir le Patreon',
	youtube: 'YouTube',
	twitch: 'Twitch',
	instagram: 'Instagram',
	discord: 'Discord',
};
const clicks = Object.entries(clickLabels)
	.map(([target, label]) => ({ label, n: stats?.clicks.find((row) => row.target === target)?.n ?? 0 }))
	.sort((a, b) => b.n - a.n);

const deviceLabels: Record<string, string> = { mobile: 'Téléphone', desktop: 'Ordinateur', tablet: 'Tablette' };
let regions: Intl.DisplayNames | null = null;
try {
	regions = new Intl.DisplayNames('fr', { type: 'region' });
} catch {}
const countryName = (code: string) => {
	try {
		return regions?.of(code) ?? code;
	} catch {
		return code;
	}
};

const breakdowns = stats
	? [
			{ title: 'Clics par bouton', note: 'Boutons Patreon, cartes et réseaux du bas de page.', rows: clicks },
			{
				title: 'D’où viennent les visiteurs',
				note: 'Site d’où vient le clic. Les visites directes (lien tapé, appli) ne sont pas listées.',
				rows: stats.referrers.map((row) => ({ label: row.referrer, n: row.n })),
			},
			{ title: 'Appareils', note: 'Visites par type d’appareil.', rows: stats.devices.map((row) => ({ label: deviceLabels[row.device] ?? row.device, n: row.n })) },
			{ title: 'Pays', note: 'Visites par pays.', rows: stats.countries.map((row) => ({ label: countryName(row.country), n: row.n })) },
		]
	: [];

const empty = stats !== null && stats.current.views === 0 && stats.current.packClicks === 0 && stats.current.videos === 0;
---

<AdminLayout title="Statistiques" active="stats" auth={auth}>
	{
		stats && (
			<>
				<nav class="periods" aria-label="Période">
					{presets.map((preset) => (
						<a href={`/admin?jours=${preset}`} class:list={['period', { 'period--active': preset === days }]} aria-current={preset === days ? 'true' : undefined}>
							{preset} derniers jours
						</a>
					))}
				</nav>

				{empty && (
					<p class="empty">
						Pas encore de visite enregistrée sur cette période : les chiffres se remplissent dès les premières visites du site.
					</p>
				)}

				<section class="kpis" aria-label="Chiffres clés">
					{kpis.map((kpi) => {
						const change = delta(kpi.value, kpi.previous);
						return (
							<div class="kpi">
								<p class="kpi-label">{kpi.label}</p>
								<p class="kpi-value">{number.format(kpi.value)}</p>
								{change && (
									<p class:list={['kpi-delta', { 'kpi-delta--up': change.up === true, 'kpi-delta--down': change.up === false }]}>
										{change.text} <span>vs les {days} jours d’avant</span>
									</p>
								)}
							</div>
						);
					})}
					<div class="kpi">
						<p class="kpi-label">Taux de clic</p>
						<p class="kpi-value">{conversion === null ? '—' : percent.format(conversion)}</p>
						<p class="kpi-delta kpi-delta--neutral">
							{conversion !== null && previousConversion !== null ? `${percent.format(previousConversion)} avant · ` : ''}
							<span>clics vers Patreon par visiteur</span>
						</p>
					</div>
				</section>

				<section class="card" aria-labelledby="visits-title">
					<h2 id="visits-title">Visites par jour</h2>
					<p class="note">Survole une colonne pour le détail du jour.</p>
					<div class="chart" data-chart>
						<div class="plot">
							{[1, 0.5, 0].map((ratio) => (
								<div class="grid" style={`bottom: ${ratio * 100}%`}>
									<span>{number.format(yMax * ratio)}</span>
								</div>
							))}
							<div class="columns">
								{series.map((point) => (
									<div
										class="column"
										tabindex="0"
										data-tip={`${dateLong.format(asDate(point.day))} · ${number.format(point.views)} visite${point.views > 1 ? 's' : ''} · ${number.format(point.visitors)} visiteur${point.visitors > 1 ? 's' : ''}`}
										aria-label={`${dateLong.format(asDate(point.day))} : ${point.views} visites, ${point.visitors} visiteurs`}
									>
										{point.views > 0 && <div class="bar" style={`height: ${(point.views / yMax) * 100}%`} />}
										{point === peak && point.views > 0 && (
											<span class="peak" style={`bottom: ${(point.views / yMax) * 100}%`}>
												{number.format(point.views)}
											</span>
										)}
									</div>
								))}
							</div>
						</div>
						<div class="axis" aria-hidden="true">
							{series.map((point, index) => (
								<span>{(days - 1 - index) % tickEvery === 0 ? dateShort.format(asDate(point.day)) : ''}</span>
							))}
						</div>
						<div class="tooltip" role="status" hidden data-tooltip />
					</div>
					<details class="table">
						<summary>Voir les chiffres jour par jour</summary>
						<table>
							<thead>
								<tr>
									<th scope="col">Jour</th>
									<th scope="col">Visites</th>
									<th scope="col">Visiteurs</th>
								</tr>
							</thead>
							<tbody>
								{[...series].reverse().map((point) => (
									<tr>
										<th scope="row">{dateLong.format(asDate(point.day))}</th>
										<td>{number.format(point.views)}</td>
										<td>{number.format(point.visitors)}</td>
									</tr>
								))}
							</tbody>
						</table>
					</details>
				</section>

				<div class="breakdowns">
					{breakdowns.map((block) => {
						const max = Math.max(1, ...block.rows.map((row) => row.n));
						return (
							<section class="card">
								<h2>{block.title}</h2>
								<p class="note">{block.note}</p>
								{block.rows.length === 0 ? (
									<p class="none">Rien pour l’instant.</p>
								) : (
									<ul class="hbars">
										{block.rows.map((row) => (
											<li>
												<span class="hbar-label">{row.label}</span>
												<span class="hbar-track">
													{row.n > 0 && <span class="hbar" style={`width: ${(row.n / max) * 100}%`} />}
													<span class="hbar-value">{number.format(row.n)}</span>
												</span>
											</li>
										))}
									</ul>
								)}
							</section>
						);
					})}
				</div>

				<p class="footnote">
					Sans cookie et sans stocker d’adresse IP : un visiteur est reconnu le temps d’une journée, puis devient anonyme. Les
					robots (moteurs de recherche, aperçus de liens) ne sont pas comptés. Tes propres visites du site, elles, le sont.
				</p>
			</>
		)
	}
</AdminLayout>

<style>
	.periods {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
		margin-top: 20px;
	}

	.period {
		padding: 6px 14px;
		border: 2px solid #260c69;
		border-radius: 999px;
		background: #fff;
		color: #260c69;
		font-weight: 600;
		text-decoration: none;
	}

	.period--active {
		background: #260c69;
		color: #fff;
	}

	.empty {
		margin: 20px 0 0;
		padding: 12px 16px;
		border-radius: 14px;
		background: #fff;
		font-weight: 600;
	}

	.kpis {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
		gap: 12px;
		margin-top: 20px;
	}

	.kpi,
	.card {
		border: 3px solid #260c69;
		border-radius: 20px;
		background: #fff;
	}

	.kpi {
		padding: 14px 16px;
	}

	.kpi p {
		margin: 0;
	}

	.kpi-label {
		font-size: 14px;
		font-weight: 600;
		opacity: 0.75;
	}

	.kpi-value {
		margin-top: 2px !important;
		font-size: 36px;
		font-weight: 700;
		line-height: 1.1;
	}

	.kpi-delta {
		margin-top: 6px !important;
		font-size: 13px;
		font-weight: 700;
	}

	.kpi-delta span {
		font-weight: 400;
		opacity: 0.75;
	}

	.kpi-delta--up {
		color: #1b7a3d;
	}

	.kpi-delta--down {
		color: #c0143c;
	}

	.kpi-delta--neutral {
		font-weight: 600;
	}

	.card {
		margin-top: 16px;
		padding: 18px 20px;
	}

	.card h2 {
		font-size: 26px;
	}

	.note {
		margin: 2px 0 0;
		font-size: 13px;
		opacity: 0.7;
	}

	/* Visites par jour : colonnes de 24px max, extrémité arrondie, grille en filet discret */
	.chart {
		position: relative;
		margin-top: 18px;
	}

	.plot {
		position: relative;
		height: 200px;
		margin-left: 44px;
	}

	.grid {
		position: absolute;
		left: 0;
		right: 0;
		border-top: 1px solid #ece6f7;
	}

	.grid span {
		position: absolute;
		right: calc(100% + 8px);
		top: 0;
		translate: 0 -50%;
		font-size: 12px;
		font-variant-numeric: tabular-nums;
		opacity: 0.7;
	}

	.columns {
		position: absolute;
		inset: 0;
		display: flex;
		align-items: flex-end;
		gap: 2px;
	}

	.column {
		position: relative;
		display: flex;
		flex: 1;
		align-items: flex-end;
		justify-content: center;
		height: 100%;
		outline: none;
		cursor: default;
	}

	.bar {
		width: min(24px, 100%);
		min-height: 2px;
		border-radius: 4px 4px 0 0;
		background: #7962e9;
		transition: background-color 0.1s;
	}

	.column:hover .bar,
	.column:focus-visible .bar {
		background: #5a43cf;
	}

	.column:focus-visible {
		box-shadow: inset 0 0 0 2px #260c69;
		border-radius: 4px;
	}

	.peak {
		position: absolute;
		left: 50%;
		translate: -50% -4px;
		font-size: 12px;
		font-weight: 700;
		white-space: nowrap;
	}

	.axis {
		display: flex;
		gap: 2px;
		margin: 6px 0 0 44px;
	}

	.axis span {
		flex: 1;
		overflow: visible;
		font-size: 12px;
		white-space: nowrap;
		opacity: 0.7;
	}

	.tooltip {
		position: absolute;
		z-index: 1;
		padding: 6px 10px;
		border-radius: 10px;
		background: #260c69;
		color: #fff;
		font-size: 13px;
		font-weight: 600;
		white-space: nowrap;
		pointer-events: none;
		translate: -50% calc(-100% - 8px);
	}

	.table {
		margin-top: 14px;
		font-size: 14px;
	}

	.table summary {
		font-weight: 600;
		cursor: pointer;
	}

	.table table {
		width: 100%;
		margin-top: 8px;
		border-collapse: collapse;
		font-variant-numeric: tabular-nums;
	}

	.table th,
	.table td {
		padding: 4px 8px;
		border-bottom: 1px solid #ece6f7;
		text-align: right;
	}

	.table th[scope='row'],
	.table thead th:first-child {
		text-align: left;
		font-weight: 400;
	}

	.breakdowns {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 0 16px;
	}

	.none {
		margin: 12px 0 0;
		font-size: 14px;
		opacity: 0.7;
	}

	/* Barres horizontales : 14px d'épaisseur, valeur au bout */
	.hbars {
		margin: 12px 0 0;
		padding: 0;
		list-style: none;
	}

	.hbars li {
		display: grid;
		grid-template-columns: 130px 1fr;
		align-items: center;
		gap: 10px;
		padding: 4px 0;
	}

	.hbar-label {
		overflow: hidden;
		font-size: 14px;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.hbar-track {
		display: flex;
		align-items: center;
		gap: 8px;
	}

	.hbar {
		height: 14px;
		border-radius: 0 4px 4px 0;
		background: #7962e9;
	}

	.hbar-value {
		font-size: 14px;
		font-weight: 700;
		font-variant-numeric: tabular-nums;
	}

	.footnote {
		margin: 20px 0 0;
		font-size: 13px;
		opacity: 0.7;
	}

	@media (max-width: 600px) {
		.kpi-value {
			font-size: 30px;
		}

		.hbars li {
			grid-template-columns: 100px 1fr;
		}
	}
</style>

<script>
	// Détail d'un jour au survol ou au focus clavier d'une colonne
	const chart = document.querySelector<HTMLElement>('[data-chart]');
	const tooltip = chart?.querySelector<HTMLElement>('[data-tooltip]');

	function show(column: HTMLElement) {
		if (!chart || !tooltip) return;
		tooltip.textContent = column.dataset.tip ?? '';
		tooltip.hidden = false;
		const box = column.getBoundingClientRect();
		const frame = chart.getBoundingClientRect();
		const bar = column.querySelector('.bar')?.getBoundingClientRect();
		const left = Math.min(Math.max(box.left + box.width / 2 - frame.left, tooltip.offsetWidth / 2), frame.width - tooltip.offsetWidth / 2);
		tooltip.style.left = `${left}px`;
		tooltip.style.top = `${(bar ? bar.top : box.bottom) - frame.top}px`;
	}

	chart?.querySelectorAll<HTMLElement>('.column').forEach((column) => {
		column.addEventListener('pointerenter', () => show(column));
		column.addEventListener('focus', () => show(column));
		column.addEventListener('pointerleave', () => tooltip && (tooltip.hidden = true));
		column.addEventListener('blur', () => tooltip && (tooltip.hidden = true));
	});
</script>
