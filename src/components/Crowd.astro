---
import { Image } from 'astro:assets';
import { siDiscord, siInstagram, siPatreon, siTwitch, siYoutube } from 'simple-icons';
import crowd from '../../design/Bottom.png';

// Les liens se règlent dans /admin (redirections /go/<clé>) ; l'icône Patreon suit le bouton « Voir le Patreon ».
const socials = [
	{ label: 'YouTube', href: '/go/youtube', icon: siYoutube },
	{ label: 'Twitch', href: '/go/twitch', icon: siTwitch },
	{ label: 'Instagram', href: '/go/instagram', icon: siInstagram },
	{ label: 'Discord', href: '/go/discord', icon: siDiscord },
	{ label: 'Patreon', href: '/go/patreon', icon: siPatreon },
];
const year = new Date().getFullYear();
---

<footer class="crowd">
	<div class="img" data-parallax="0.25">
		<Image src={crowd} alt="" widths={[1280, 1920, 2577]} sizes="(max-width: 899px) 134vw, 100vw" />
	</div>

	<div class="content">
		<p class="display-title cap-trim label" data-reveal="up">Viens me suivre&nbsp;!</p>

		<ul class="socials" data-reveal-group="pop">
			{
				socials.map(({ label, href, icon }) => (
					<li>
						<a class="social" href={href} target="_blank" rel="noopener" aria-label={label} title={label}>
							<svg viewBox="0 0 24 24" aria-hidden="true">
								<path d={icon.path} />
							</svg>
						</a>
					</li>
				))
			}
		</ul>

		<p class="display-title cap-trim copyright" data-reveal="up">© {year} Keyato</p>
	</div>
</footer>

<style>
	.crowd {
		position: relative;
		height: calc(322 * var(--u));
		overflow: clip;
	}

	.img {
		width: 100%;
	}

	.img :global(img) {
		width: 100%;
		height: auto;
	}

	/* Contenu posé sur la foule, dans le style des titres, des cartes et des boutons de la page */
	.content {
		position: absolute;
		inset: 0;
	}

	.label {
		position: absolute;
		top: calc(44 * var(--u));
		left: 0;
		right: 0;
		font-size: calc(53.4 * var(--u));
	}

	.socials {
		position: absolute;
		top: calc(108 * var(--u));
		left: 0;
		right: 0;
		display: flex;
		gap: calc(34 * var(--u));
		width: fit-content;
		margin: 0 auto;
		padding: calc(18 * var(--u)) calc(40 * var(--u));
		list-style: none;
		border: calc(8 * var(--u)) solid var(--c-navy);
		border-radius: calc(80 * var(--u));
		background: var(--c-patreon-bg);
	}

	.social {
		display: grid;
		place-items: center;
		width: calc(92 * var(--u));
		height: calc(92 * var(--u));
		border: calc(6 * var(--u)) solid var(--c-white);
		border-radius: 50%;
		background: var(--c-navy);
		outline: none;
		transition:
			transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1),
			background-color 0.2s;
	}

	.social svg {
		width: 46%;
		fill: var(--c-patreon-bg);
	}

	.social:hover,
	.social:focus-visible {
		transform: scale(1.12);
		background: var(--c-basique);
	}

	.social:focus-visible {
		box-shadow: 0 0 0 calc(4 * var(--u)) var(--c-navy);
	}

	.copyright {
		position: absolute;
		top: calc(272 * var(--u));
		left: 0;
		right: 0;
		font-size: calc(25 * var(--u));
	}

	@media (prefers-reduced-motion: reduce) {
		.social {
			transition: none;
		}
	}

	/*
	 * Mobile : contenu empilé, dimensions en px mobile (--m, voir global.css).
	 * La foule, plus large que l'écran pour garder des personnages lisibles, est plus haute que le footer :
	 * la parallaxe ne découvre jamais de vide (translate centre l'image sans toucher au transform de la parallaxe).
	 */
	@media (max-width: 899px) {
		.crowd {
			height: auto;
		}

		.img {
			position: absolute;
			top: 0;
			left: 50%;
			width: max(100%, calc(520 * var(--m)));
			translate: -50% 0;
		}

		.content {
			position: relative;
			inset: auto;
			display: flex;
			flex-direction: column;
			align-items: center;
			padding: calc(36 * var(--m)) 16px calc(30 * var(--m));
		}

		.label,
		.socials,
		.copyright {
			position: static;
		}

		.label {
			font-size: calc(32 * var(--m));
		}

		.socials {
			gap: calc(10 * var(--m));
			margin: calc(18 * var(--m)) 0 calc(20 * var(--m));
			padding: calc(10 * var(--m)) calc(16 * var(--m));
			border-width: calc(4 * var(--m));
			border-radius: calc(60 * var(--m));
		}

		.social {
			width: calc(48 * var(--m));
			height: calc(48 * var(--m));
			border-width: calc(3 * var(--m));
		}

		.copyright {
			font-size: calc(16 * var(--m));
		}
	}
</style>
