---
import '@fontsource/sniglet/800.css';
import { getImage, Image } from 'astro:assets';
import mainBg from '../../design/Sector.02.png';
// Paper.png avec les bras prolongés (scripts/extend-paper.mjs)
import paper from '../assets/paper-extended.png';
// La même sans texte, affichée quand le texte de la feuille est modifié dans /admin (src/lib/render.ts)
import paperBlankSrc from '../assets/paper-blank-extended.png';
import packBasique from '../../design/Pack.01.png';
import packsDuo from '../../design/Pack.03.png';
import PackCard from './PackCard.astro';

const paperWidths = [1000, 1960, 2940, 3484];
const paperBlank = await getImage({ src: paperBlankSrc, widths: paperWidths });
---

<section class="details">
	<div class="bg">
		<Image data-slot="mainBg" src={mainBg} alt="" widths={[1280, 1742]} sizes="100vw" />
	</div>

	<h2 class="display-title cap-trim title" data-text="sectionTitle" data-parallax="-0.04" data-reveal="up" data-exit="right">Qu'y a-t-il dans ces vidéos&nbsp;?</h2>

	<div class="paper" data-paper data-parallax="0.04" data-parallax-mobile="0" data-reveal="rise">
		<Image
			src={paper}
			alt=""
			widths={paperWidths}
			sizes="(max-width: 899px) 1px, 102vw"
			data-blank-src={paperBlank.src}
			data-blank-srcset={paperBlank.srcSet.attribute}
		/>
		<!-- Texte de la feuille : lu par les lecteurs d'écran sur ordinateur (il est dessiné dans l'image), affiché sur mobile -->
		<div class="paper-text" data-paper-text>
			<p>
				Mon objectif dans ces vidéos c'est vraiment de t'expliquer la base de la création visuelle en prenant en exemple 3 étapes
				clefs de la création de mes vidéos.
			</p>
			<p>Dans le premier pack, tu trouveras 8 vidéos qui parleront :</p>
			<ul>
				<li>Pipeline</li>
				<li>Méthode de travail</li>
				<li>Matériel / logiciel</li>
				<li>Audio</li>
				<li>Montage</li>
			</ul>
			<p>et encore plein d'autres sujets.</p>
			<p>
				Si t'es intéressé à aller plus loin, dans le deuxième pack, tu pourras retrouver en plus : une introduction à la 3D, une
				review montage de ce que je fais, des conseils YouTube avec les insides et encore d'autres bonus.
			</p>
			<p>Je rappelle que ce n'est pas un tuto dessin mais que j'expliquerai plutôt un process et une méthode.</p>
			<p>Si t'es intéressé, hésite pas à aller check le Patreon. :)</p>
		</div>
	</div>

	<div class="cards">
		<PackCard variant="basique" href="/go/basique" label="Pack Basique" pack={packBasique} />
		<PackCard variant="plus" href="/go/plus" label="Pack Plus +" pack={packsDuo} />
	</div>

	<a class="patreon" href="/go/patreon" target="_blank" rel="noopener" data-reveal="pop"><span class="pill"><span class="cap-trim" data-text="patreonLabel">Voir le Patreon</span></span></a>
</section>

<style>
	/*
	 * Composition de la maquette, resserrée : titre à 70 %, papier à 75 %, cartes à 55 %, bouton Patreon à 50 %.
	 * Passe par-dessus le hero au scroll.
	 */
	.details {
		position: relative;
		z-index: 1;
		height: calc(2125 * var(--u));
		overflow: clip;
		background: var(--c-main-bg);
	}

	/* Liseré blanc entre le rose et le violet */
	.details::before {
		content: '';
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1;
		height: calc(7 * var(--u));
		background: var(--c-white);
	}

	.details :global(img) {
		width: 100%;
		height: auto;
	}

	.bg {
		position: absolute;
		top: calc(4 * var(--u));
		left: 0;
		width: 100%;
	}

	.title {
		position: absolute;
		top: calc(128 * var(--u));
		left: 0;
		right: 0;
		font-size: calc(74.2 * var(--u));
	}

	/* Papier à 75 %, centré ; les bras prolongés dépassent un peu des bords de la page */
	.paper {
		position: absolute;
		top: calc(280 * var(--u));
		left: calc(-18.55 * var(--u));
		width: calc(1957.1 * var(--u));
	}

	/* Cotes des cartes : maquette × --cu (voir PackCard.astro), groupe centré comme sur la maquette */
	.cards {
		--cu: calc(var(--u) * 0.55);
		position: absolute;
		top: calc(1657 * var(--u));
		left: calc(513.45 * var(--u));
	}

	.patreon {
		--cu: calc(var(--u) * 0.5);
		position: absolute;
		top: calc(1993 * var(--u));
		left: calc(737 * var(--u));
		display: block;
		width: calc(890 * var(--cu));
		height: calc(165 * var(--cu));
		outline: none;
	}

	/*
	 * Le bouton visible. Les effets de survol sont sur lui et non sur le lien : GSAP anime le lien (apparition au scroll)
	 * et y force aussi scale / translate / rotate à none.
	 */
	.pill {
		position: relative;
		display: block;
		height: 100%;
		padding-top: calc(47 * var(--cu));
		border-radius: calc(82.5 * var(--cu));
		background: var(--c-patreon-bg);
		color: var(--c-patreon-text);
		font-size: calc(100.3 * var(--cu));
		text-align: center;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
		transition:
			scale 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			translate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			rotate 0.35s cubic-bezier(0.34, 1.56, 0.64, 1),
			box-shadow 0.25s ease-out,
			color 0.2s;
	}

	/* Reflet qui traverse le bouton au survol */
	.pill::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(100deg, transparent 30%, rgb(255 255 255 / 0.85) 50%, transparent 70%);
		transform: translateX(-120%);
		pointer-events: none;
	}

	/*
	 * Survol : le bouton se soulève en s'inclinant, une ombre bleu nuit apparaît dessous et un reflet le traverse.
	 * Seulement avec une souris : sur écran tactile, le survol resterait collé après un tap.
	 */
	@media (hover: hover) {
		.patreon:hover .pill {
			scale: 1.06;
			translate: 0 calc(-10 * var(--cu));
			rotate: -2deg;
			box-shadow: 0 calc(14 * var(--cu)) 0 var(--c-navy);
			color: var(--c-basique);
		}

		.patreon:hover .pill::after {
			animation: patreon-shine 0.7s ease-out;
		}
	}

	.patreon:focus-visible .pill {
		scale: 1.06;
		color: var(--c-basique);
		outline: calc(4 * var(--u)) solid var(--c-white);
		outline-offset: calc(4 * var(--u));
	}

	/* Au clic, le bouton s'enfonce sur son ombre */
	.patreon:active .pill {
		scale: 1.02;
		translate: 0;
		box-shadow: 0 calc(4 * var(--cu)) 0 var(--c-navy);
		transition-duration: 0.08s;
	}

	@keyframes patreon-shine {
		to {
			transform: translateX(120%);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pill {
			transition: none;
		}

		.patreon:hover .pill {
			translate: none;
			rotate: none;
		}

		.patreon:hover .pill::after {
			animation: none;
		}
	}

	.paper-text {
		position: absolute;
		width: 1px;
		height: 1px;
		margin: -1px;
		overflow: hidden;
		clip: rect(0, 0, 0, 0);
		white-space: nowrap;
	}

	/*
	 * Texte de la feuille modifié dans /admin (classe ajoutée par le Worker, src/lib/render.ts) : la feuille d'origine est
	 * remplacée par la feuille vierge et le texte est écrit en HTML, dans la zone du texte d'origine
	 * (918–2530 × 254–2077 px de l'image prolongée, soit 0.5617 px maquette par px), resserrée pour passer entre les
	 * pouces. Trop long, il est rétréci (script). Ses paragraphes sont injectés par le Worker, sans l'attribut du CSS
	 * scopé d'Astro : d'où les :global().
	 */
	@media (min-width: 900px) {
		.paper--custom .paper-text {
			left: calc(545 * var(--u));
			top: calc(142.7 * var(--u));
			width: calc(830 * var(--u));
			height: calc(1024 * var(--u));
			margin: 0;
			clip: auto;
			white-space: normal;
			rotate: -1deg;
			color: var(--c-ink);
			font-family: 'Sniglet', system-ui, sans-serif;
			font-size: calc(32 * var(--u));
			font-weight: 800;
			line-height: 1.28;
		}

		.paper--custom .paper-text :global(p),
		.paper--custom .paper-text :global(ul) {
			margin: 0 0 0.8em;
			padding: 0;
			list-style: none;
		}

		.paper--custom .paper-text :global(li)::before {
			content: '-';
		}
	}

	/*
	 * Mobile : composition empilée, dimensions en px mobile (--m, voir global.css).
	 * Le texte de la feuille serait illisible dans l'image : il est affiché en vrai texte sur une feuille en CSS.
	 */
	@media (max-width: 899px) {
		.details {
			display: flex;
			flex-direction: column;
			align-items: center;
			height: auto;
			/* Même espace sous le bouton Patreon qu'entre la feuille et les cartes (56px) */
			padding: calc(56 * var(--m)) 16px calc(56 * var(--m));
		}

		.bg {
			inset: 0;
			width: auto;
		}

		.details .bg :global(img) {
			height: 100%;
			object-fit: cover;
		}

		.title,
		.paper,
		.cards,
		.patreon {
			position: relative;
			top: auto;
			left: auto;
		}

		.title {
			right: auto;
			font-size: calc(36 * var(--m));
			white-space: normal;
			text-wrap: balance;
			--lh: 1.05;
		}

		.paper {
			width: 100%;
			max-width: calc(358 * var(--m));
			margin-top: calc(36 * var(--m));
		}

		.paper :global(img) {
			display: none;
		}

		.paper-text {
			position: static;
			width: auto;
			height: auto;
			margin: 0;
			overflow: visible;
			clip: auto;
			white-space: normal;
			padding: calc(28 * var(--m)) calc(24 * var(--m));
			border: calc(4 * var(--m)) solid var(--c-ink);
			border-radius: calc(6 * var(--m));
			background: var(--c-paper);
			box-shadow: calc(6 * var(--m)) calc(6 * var(--m)) 0 var(--c-navy);
			rotate: -1.5deg;
			color: var(--c-ink);
			font-family: 'Sniglet', system-ui, sans-serif;
			font-size: calc(17 * var(--m));
			font-weight: 800;
			line-height: 1.3;
		}

		.paper-text :global(p),
		.paper-text :global(ul) {
			margin: 0 0 calc(14 * var(--m));
			padding: 0;
			list-style: none;
		}

		.paper-text :global(p:last-child) {
			margin-bottom: 0;
		}

		/* Tirets de la liste, comme sur la feuille */
		.paper-text :global(li)::before {
			content: '-';
		}

		/* Deux cartes de 174px côte à côte (cotes de la maquette × --cu, voir PackCard.astro) */
		.cards {
			--cu: calc(var(--m) * 0.2459);
			width: calc(1456 * var(--cu));
			height: calc(511 * var(--cu));
			/* 56px visibles sous la feuille : + 6 d'ombre + 4.5 de débord dû à l'inclinaison de la feuille */
			margin-top: calc((56 + 6 + 4.5) * var(--m));
		}

		.patreon {
			--cu: calc(var(--m) * 0.36);
			flex: none;
			margin-top: calc(32 * var(--m));
		}
	}
</style>

<script>
	// Texte de la feuille modifié, sur ordinateur : rétréci jusqu'à tenir dans la feuille s'il est trop long
	const text = document.querySelector<HTMLElement>('.paper--custom .paper-text');
	const desktop = window.matchMedia('(min-width: 900px)');

	function fit() {
		if (!text) return;
		text.style.removeProperty('font-size');
		if (!desktop.matches) return;
		let size = parseFloat(getComputedStyle(text).fontSize);
		while (text.scrollHeight > text.clientHeight + 1 && size > 8) {
			size *= 0.95;
			text.style.fontSize = `${size}px`;
		}
	}

	if (text) {
		fit();
		document.fonts.ready.then(fit);
		let timer = 0;
		window.addEventListener('resize', () => {
			clearTimeout(timer);
			timer = window.setTimeout(fit, 150);
		});
	}
</script>
